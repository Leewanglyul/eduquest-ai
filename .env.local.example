# LOCAL profile template (Supabase CLI stack started with `supabase start`).
#
# You normally do not edit this by hand: `pnpm env:local` fills the real, git-ignored profile
# (.env.profiles/local.env) from `supabase status -o env` and activates it as .env.local.
#
# Manual use: copy this file to .env.profiles/local.env and paste the values printed by
# `supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
#
# Never commit real values. .env.local and .env.profiles/ are git-ignored.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status -o env`>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase status -o env`>
