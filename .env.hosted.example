# HOSTED profile template (a Supabase cloud project).
#
# Copy to .env.profiles/hosted.env (git-ignored) and fill in the values from the Dashboard:
# Project Settings -> API. `pnpm env:hosted` then validates it and activates it as .env.local.
#
# Use a STAGING project for development. Never point day-to-day development at production.
# Never commit real values. Never paste the service-role key into a chat, ticket or build log.

# Which hosted project this is: staging | production
# (switching to a "production" profile requires `pnpm env:hosted -- --allow-production`)
EDUQUEST_PROFILE_LABEL=staging

# Project URL, for example https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=<https://PROJECT-REF.supabase.co>

# anon / publishable key of THIS project (public by design)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or sb_publishable_ key>

# service_role / secret key of THIS project. SECRET: server only.
SUPABASE_SERVICE_ROLE_KEY=<service_role or sb_secret_ key>
